{
  "name": "facaamigos",
  "private": true,
  "version": "0.1.0",
  "description": "Sistema operacional FaçaAmigos — quiosque offline-first + back-office em nuvem",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\""
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.7.0",
    "prettier": "^3.4.0"
  }
}
