{
  "name": "@facaamigos/kiosk",
  "private": true,
  "version": "0.1.7",
  "description": "Electron main + servidor Fastify local (D1/D2 do plano) — única gravadora do ponto, serve a SPA para o Electron e para os tablets da LAN.",
  "type": "module",
  "main": "./bundle/main.mjs",
  "scripts": {
    "dev:server": "tsx watch src/server/start.ts",
    "build": "tsc -p tsconfig.json",
    "bundle": "node scripts/bundle.mjs",
    "start:electron": "pnpm run bundle && electron .",
    "dist": "pnpm run bundle && electron-builder --win",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@facaamigos/contracts": "workspace:*",
    "@facaamigos/db-local": "workspace:*",
    "@facaamigos/domain": "workspace:*",
    "@facaamigos/fiscal": "workspace:*",
    "@fastify/cors": "^10.0.1",
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.0.1",
    "@supabase/supabase-js": "^2.45.0",
    "@types/qrcode": "^1.5.6",
    "electron-log": "^5.2.4",
    "electron-updater": "^6.8.9",
    "fastify": "^5.2.0",
    "node-forge": "^1.4.0",
    "qrcode": "^1.5.4",
    "selfsigned": "^2.4.1",
    "ws": "^8.18.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@facaamigos/config": "workspace:*",
    "@types/node": "^22.10.0",
    "@types/node-forge": "^1.3.11",
    "@types/ws": "^8.5.13",
    "electron": "^37.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.0",
    "eslint": "catalog:",
    "tsx": "^4.19.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
