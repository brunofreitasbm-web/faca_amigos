{
  "name": "@facaamigos/kiosk",
  "private": true,
  "version": "0.1.0",
  "description": "Electron main + servidor Fastify local (D1/D2 do plano) — única gravadora do ponto, serve a SPA para o Electron e para os tablets da LAN.",
  "type": "module",
  "main": "./dist/main/main.js",
  "scripts": {
    "dev:server": "tsx watch src/server/start.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@facaamigos/contracts": "workspace:*",
    "@facaamigos/db-local": "workspace:*",
    "@facaamigos/domain": "workspace:*",
    "@fastify/cors": "^10.0.1",
    "@fastify/websocket": "^11.0.1",
    "@supabase/supabase-js": "^2.45.0",
    "fastify": "^5.2.0",
    "selfsigned": "^2.4.1",
    "ws": "^8.18.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@facaamigos/config": "workspace:*",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "electron": "^33.2.0",
    "eslint": "catalog:",
    "tsx": "^4.19.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
