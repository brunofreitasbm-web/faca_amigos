# Configuração do build web/PWA do quiosque (Vite).
#
# NUNCA versione o .env preenchido. Estes dois valores acabam embutidos
# no bundle publicado (o browser lê `import.meta.env.VITE_*` em tempo
# de build) — não é o lugar de nenhuma chave secreta.
#
# Vercel: Project Settings > Environment Variables, copiando os nomes
# abaixo. GitHub Actions (apps/kiosk instalador Electron, que também
# builda este pacote): Settings > Secrets and variables > Actions >
# Variables, mesmos nomes — ver .github/workflows/build-kiosk.yml.

# URL do projeto Supabase. Não é segredo (vai em toda requisição do
# navegador). Mesmo projeto usado por apps/backoffice e apps/kiosk.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave publicável do Supabase, formato novo (sb_publishable_...).
# Também não é segredo — é a chave feita pra rodar no navegador, só dá
# acesso ao que as policies de RLS permitirem para um usuário anônimo/
# autenticado. Pegue em: Supabase > Project Settings > API Keys.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_TROQUE_AQUI
